# ==========================================================
# Customer Churn Decision Engine — AI Configuration
# ==========================================================
# Provide an API key for automatic AI-powered metric classification.
# The system supports both Google Gemini (recommended, free tier) and OpenAI.

# Option 1: Google Gemini API (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Option 2: OpenAI API (Get key at: https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# AI Provider override ('gemini' or 'openai'). If omitted, auto-detected from set keys.
AI_PROVIDER=gemini

# Optional model overrides:
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_MODEL=gpt-4o-mini
